<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI 여행 일정 플래너</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 아이콘 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Noto Sans KR 폰트 -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                        }
                    },
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        /* 스크롤바 숨기기 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between max-w-md mx-auto shadow-2xl border-x border-slate-100">

    <!-- 상단 헤더 -->
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-100 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-9 h-9 rounded-full bg-brand-500 flex items-center justify-center text-white font-bold text-lg shadow-sm">
                <i class="fa-solid fa-plane-departure"></i>
            </div>
            <div>
                <h1 class="font-bold text-slate-900 leading-tight">TripAI Planner</h1>
                <p class="text-[11px] text-slate-400">Gemini 기반 맞춤 여행 일정</p>
            </div>
        </div>
        <button id="reset-btn" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 px-3 py-1.5 rounded-full font-medium transition">
            <i class="fa-solid fa-rotate-right mr-1"></i>새 일정
        </button>
    </header>

    <!-- 메인 컨텐츠 영역 -->
    <main class="flex-1 p-4 pb-24 overflow-y-auto">

        <!-- 1. 일정 생성 폼 섹션 -->
        <section id="form-section" class="space-y-5">
            <div class="bg-gradient-to-br from-brand-600 to-indigo-700 rounded-2xl p-5 text-white shadow-lg shadow-brand-500/20">
                <span class="bg-white/20 text-xs px-2.5 py-1 rounded-full font-medium backdrop-blur-md mb-2 inline-block">AI 여행 비서</span>
                <h2 class="text-xl font-bold mb-1">어디로 떠나고 싶으신가요?</h2>
                <p class="text-xs text-brand-100">원하는 조건만 입력하면 Gemini가 완성형 일정을 만들어 줍니다.</p>
            </div>

            <form id="plan-form" class="space-y-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
                <!-- 여행지 입력 -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                        <i class="fa-solid fa-location-dot text-brand-500 mr-1"></i> 여행지
                    </label>
                    <input type="text" id="destination" required placeholder="예: 제주도, 도쿄, 파리, 부산" 
                        class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition">
                </div>

                <!-- 기간 선택 -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                            <i class="fa-regular fa-calendar text-brand-500 mr-1"></i> 일수
                        </label>
                        <select id="duration" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition">
                            <option value="1">당일 치기</option>
                            <option value="2">1박 2일</option>
                            <option value="3" selected>2박 3일</option>
                            <option value="4">3박 4일</option>
                            <option value="5">4박 5일 이상</option>
                        </select>
                    </div>

                    <!-- 동행자 선택 -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                            <i class="fa-solid fa-user-group text-brand-500 mr-1"></i> 누구와
                        </label>
                        <select id="companion" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition">
                            <option value="혼자">혼자서</option>
                            <option value="커플/연인" selected>연인/커플</option>
                            <option value="친구들과">친구들과</option>
                            <option value="부모님과">부모님과</option>
                            <option value="아이와 함께">아이와 함께</option>
                        </select>
                    </div>
                </div>

                <!-- 관심사 (다중 선택 태그) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2">
                        <i class="fa-solid fa-[#0ea5e9] fa-heart text-brand-500 mr-1"></i> 관심사 / 여행 스타일 (다중 선택)
                    </label>
                    <div class="flex flex-wrap gap-2" id="interest-container">
                        <button type="button" data-value="맛집/카페" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">☕️ 맛집/카페</button>
                        <button type="button" data-value="힐링/휴식" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">🌿 힐링/휴식</button>
                        <button type="button" data-value="명소/관광" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">🏛️ 필수 관광지</button>
                        <button type="button" data-value="액티비티" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">🪂 액티비티</button>
                        <button type="button" data-value="쇼핑" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">🛍️ 쇼핑</button>
                        <button type="button" data-value="문화/예술" class="interest-chip px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-600 bg-slate-50 font-medium active:scale-95 transition">🎨 전시/문화</button>
                    </div>
                </div>

                <!-- 제출 버튼 -->
                <button type="submit" id="submit-btn" class="w-full py-3.5 bg-brand-500 hover:bg-brand-600 active:scale-[0.99] text-white font-bold rounded-xl shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2 transition mt-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>AI 여행 일정 생성하기</span>
                </button>
            </form>

            <!-- 로딩 상태 스피너 (숨김) -->
            <div id="loading-state" class="hidden text-center py-12 space-y-4">
                <div class="inline-block relative w-16 h-16">
                    <div class="w-16 h-16 rounded-full border-4 border-brand-100 border-t-brand-500 animate-spin"></div>
                    <i class="fa-solid fa-paper-plane absolute inset-0 m-auto text-brand-500 text-lg animate-pulse"></i>
                </div>
                <div class="space-y-1">
                    <h3 class="font-bold text-slate-800">최적의 동선을 계산하는 중...</h3>
                    <p class="text-xs text-slate-500">Gemini AI가 가볼 만한 장소를 조합하고 있습니다.</p>
                </div>
            </div>
        </section>

        <!-- 2. 일정 결과 섹션 (기본 숨김) -->
        <section id="result-section" class="hidden space-y-4">

            <!-- 요약 카테고리 헤더 -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex justify-between items-center">
                <div>
                    <span id="result-badge" class="bg-brand-50 text-brand-600 text-[11px] font-bold px-2.5 py-1 rounded-md">2박 3일 · 연인과</span>
                    <h2 id="result-title" class="text-lg font-bold text-slate-900 mt-1">제주도 감성 여행 일정</h2>
                </div>
                <button id="share-btn" class="w-9 h-9 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-full flex items-center justify-center transition" title="일정 공유">
                    <i class="fa-solid fa-share-nodes"></i>
                </button>
            </div>

            <!-- 날짜 선택 탭 (Day 1, Day 2, Day 3 ...) -->
            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1" id="day-tabs">
                <!-- JS로 탭 생성됨 -->
            </div>

            <!-- 일정 상세 카드 리스트 -->
            <div id="itinerary-cards" class="space-y-3">
                <!-- JS로 타임라인 카드 삽입됨 -->
            </div>

            <!-- 백엔드 미연동 안내 알림 (Toast/Notice) -->
            <div id="demo-notice" class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-800 flex items-start gap-2.5">
                <i class="fa-solid fa-circle-info text-amber-500 text-sm mt-0.5"></i>
                <div>
                    <span class="font-bold">미리보기 모드 작동 중</span>
                    <p class="text-amber-700 mt-0.5">현재 Vercel API (<code>/api/plan</code>)가 연결되지 않아 예시 데이터를 보여줍니다. 엔드포인트를 구현하면 실제 Gemini 응답으로 대체됩니다.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- 하단 고정 네비게이션 / 액션 바 -->
    <footer class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white border-t border-slate-100 px-6 py-2.5 flex justify-around items-center z-20">
        <button id="nav-home" class="flex flex-col items-center gap-1 text-brand-500">
            <i class="fa-solid fa-compass text-lg"></i>
            <span class="text-[10px] font-medium">일정 짜기</span>
        </button>
        <button id="nav-saved" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600">
            <i class="fa-solid fa-bookmark text-lg"></i>
            <span class="text-[10px] font-medium">저장된 일정</span>
        </button>
    </footer>

    <!-- 알림 메시지 토스트 -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 bg-slate-900/90 text-white text-xs px-4 py-2.5 rounded-full shadow-lg transition-all duration-300 opacity-0 pointer-events-none z-50 flex items-center gap-2">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-msg">메시지 내용</span>
    </div>

    <!-- 스크립트 영역 -->
    <script>
        // 관심사 태그 선택 로직
        const selectedInterests = new Set(['맛집/카페', '힐링/휴식']);
        
        document.querySelectorAll('.interest-chip').forEach(chip => {
            const val = chip.getAttribute('data-value');
            if(selectedInterests.has(val)) {
                chip.classList.add('bg-brand-500', 'text-white', 'border-brand-500');
                chip.classList.remove('bg-slate-50', 'text-slate-600', 'border-slate-200');
            }

            chip.addEventListener('click', () => {
                if(selectedInterests.has(val)) {
                    selectedInterests.delete(val);
                    chip.classList.remove('bg-brand-500', 'text-white', 'border-brand-500');
                    chip.classList.add('bg-slate-50', 'text-slate-600', 'border-slate-200');
                } else {
                    selectedInterests.add(val);
                    chip.classList.add('bg-brand-500', 'text-white', 'border-brand-500');
                    chip.classList.remove('bg-slate-50', 'text-slate-600', 'border-slate-200');
                }
            });
        });

        // 예시 일정 시뮬레이션 데이터 생성 함수 (API 부재 시 사용)
        function generateMockData(destination, duration, companion, interests) {
            const days = parseInt(duration);
            const itinerary = [];
            const interestArr = Array.from(interests);
            const mainInterest = interestArr[0] || '관광';

            for(let d = 1; d <= days; d++) {
                const dayPlan = {
                    day: d,
                    theme: `${destination} ${d}일차: ${d === 1 ? '설레는 첫걸음' : (d === days ? '아쉬운 마무리' : '하이라이트 탐방')}`,
                    items: [
                        {
                            time: "09:30",
                            category: "아침/이동",
                            title: `${destination} 도착 및 오전 일정`,
                            desc: `현지 인기 브런치 카페에서 ${companion}와 함께 아침 식사 후 일정 시작`,
                            tag: "식사",
                            icon: "fa-utensils"
                        },
                        {
                            time: "11:30",
                            category: "오전 코스",
                            title: `${destination} 대표 ${mainInterest} 명소`,
                            desc: `SNS에서 핫한 포토스팟 둘러보기. 여유롭게 풍경 감상 및 사진 촬영`,
                            tag: mainInterest,
                            icon: "fa-camera"
                        },
                        {
                            time: "13:30",
                            category: "점심",
                            title: `현지 로컬 대표 맛집`,
                            desc: `줄 서서 먹는 유명 맛집 방문. 대표 시그니처 메뉴 즐기기`,
                            tag: "맛집",
                            icon: "fa-bowl-food"
                        },
                        {
                            time: "15:30",
                            category: "오후 코스",
                            title: `감성 힐링 뷰 포인트 및 산책`,
                            desc: `근처 뷰가 좋은 힐링 코스 거닐기 (소요시간 약 1시간 30분)`,
                            tag: "힐링",
                            icon: "fa-leaf"
                        },
                        {
                            time: "18:30",
                            category: "저녁/야경",
                            title: `야경 명소 & 분위기 좋은 저녁`,
                            desc: `하루를 마무리하는 야경 관람과 함께 즐기는 특색 있는 저녁 식사`,
                            tag: "야경",
                            icon: "fa-moon"
                        }
                    ]
                };
                itinerary.push(dayPlan);
            }

            return {
                title: `${destination} ${duration}일 여행`,
                subtitle: `${duration} · ${companion} · ${interestArr.slice(0,2).join(', ')}`,
                itinerary: itinerary
            };
        }

        // DOM 요소
        const formSection = document.getElementById('form-section');
        const planForm = document.getElementById('plan-form');
        const submitBtn = document.getElementById('submit-btn');
        const loadingState = document.getElementById('loading-state');
        const resultSection = document.getElementById('result-section');
        const resultTitle = document.getElementById('result-title');
        const resultBadge = document.getElementById('result-badge');
        const dayTabsContainer = document.getElementById('day-tabs');
        const itineraryCardsContainer = document.getElementById('itinerary-cards');
        const resetBtn = document.getElementById('reset-btn');
        const shareBtn = document.getElementById('share-btn');
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-msg');

        let currentPlanData = null;
        let activeDay = 1;

        // 토스트 표시 함수
        function showToast(msg) {
            toastMsg.textContent = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');
            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }

        // 폼 제출 handler (Vercel API 연동 + Fallback 시뮬레이션)
        planForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const destination = document.getElementById('destination').value.trim();
            const duration = document.getElementById('duration').value;
            const companion = document.getElementById('companion').value;
            const interests = Array.from(selectedInterests);

            if(!destination) {
                showToast('여행지를 입력해 주세요.');
                return;
            }

            // 로딩 표시
            planForm.classList.add('hidden');
            loadingState.classList.remove('hidden');

            const payload = {
                destination,
                duration,
                companion,
                interests
            };

            let planResult = null;

            try {
                // Vercel Serverless Function 호출 시도 (/api/plan)
                const response = await fetch('/api/plan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    planResult = await response.json();
                    document.getElementById('demo-notice').classList.add('hidden'); // 실제 연동 시 노티스 숨김
                } else {
                    throw new Error('API 응답 없음');
                }
            } catch (err) {
                console.warn('Vercel API 호출 실패 또는 미구현. Mock 데이타로 전환합니다.');
                // 1.5초 딜레이 후 모의 데이타 사용 (자연스러운 로딩 연출)
                await new Promise(res => setTimeout(res, 1200));
                planResult = generateMockData(destination, `${duration}박 ${parseInt(duration)+1}일`, companion, interests);
                document.getElementById('demo-notice').classList.remove('hidden');
            }

            // UI 업데이트
            currentPlanData = planResult;
            activeDay = 1;
            renderResults();

            // 화면 전환
            loadingState.classList.add('hidden');
            planForm.classList.remove('hidden');
            formSection.classList.add('hidden');
            resultSection.classList.remove('hidden');
        });

        // 결과 화면 렌더링
        function renderResults() {
            if(!currentPlanData) return;

            resultTitle.textContent = currentPlanData.title;
            resultBadge.textContent = currentPlanData.subtitle;

            // Day 탭 생성
            dayTabsContainer.innerHTML = '';
            currentPlanData.itinerary.forEach((dayData) => {
                const tabBtn = document.createElement('button');
                const isActive = dayData.day === activeDay;
                tabBtn.className = `px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition ${
                    isActive 
                    ? 'bg-brand-500 text-white shadow-md shadow-brand-500/20' 
                    : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50'
                }`;
                tabBtn.innerHTML = `<i class="fa-regular fa-calendar-check mr-1"></i> Day ${dayData.day}`;
                tabBtn.addEventListener('click', () => {
                    activeDay = dayData.day;
                    renderResults();
                });
                dayTabsContainer.appendChild(tabBtn);
            });

            // 선택된 Day의 카드 리스트 생성
            const currentDayObj = currentPlanData.itinerary.find(d => d.day === activeDay) || currentPlanData.itinerary[0];
            
            itineraryCardsContainer.innerHTML = `
                <div class="text-xs font-semibold text-slate-500 px-1 py-1 flex justify-between items-center">
                    <span><i class="fa-solid fa-flag text-brand-500 mr-1"></i> ${currentDayObj.theme}</span>
                    <span class="text-[11px] text-slate-400">${currentDayObj.items.length}개 장소</span>
                </div>
            `;

            currentDayObj.items.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-2xl border border-slate-100 shadow-sm relative overflow-hidden flex gap-3.5 items-start transition hover:border-slate-200";
                
                card.innerHTML = `
                    <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0 font-bold text-sm mt-0.5">
                        <i class="fa-solid ${item.icon || 'fa-location-dot'}"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] font-bold text-brand-600 bg-brand-50 px-2 py-0.5 rounded">${item.time}</span>
                            <span class="text-[10px] text-slate-400 border border-slate-100 px-1.5 py-0.5 rounded">${item.tag}</span>
                        </div>
                        <h4 class="font-bold text-slate-800 text-sm truncate">${item.title}</h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed">${item.desc}</p>
                    </div>
                `;
                itineraryCardsContainer.appendChild(card);
            });
        }

        // 처음으로 돌아가기 버튼
        resetBtn.addEventListener('click', () => {
            resultSection.classList.add('hidden');
            formSection.classList.remove('hidden');
        });

        // 클립보드 공유 기능
        shareBtn.addEventListener('click', () => {
            if(!currentPlanData) return;
            const textToCopy = `[TripAI 여행 일정]\n${currentPlanData.title} (${currentPlanData.subtitle})\n모바일 앱에서 확인해보세요!`;
            
            // 호환 가능한 복사 방식
            const tempInput = document.createElement('textarea');
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast('일정 내용이 클립보드에 복사되었습니다.');
        });

        // 하단 탭 버튼 클릭 효과 (UI용)
        document.getElementById('nav-home').addEventListener('click', () => {
            showToast('일정 작성 화면입니다.');
        });
        document.getElementById('nav-saved').addEventListener('click', () => {
            showToast('저장 기능은 로그인 후 이용 가능합니다.');
        });
    </script>
</body>
</html>
